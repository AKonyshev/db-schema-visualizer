{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": "./",
    "paths": {
      // `@/` means the visualizer's src throughout this monorepo — its own
      // components import each other that way, and they are compiled as part of
      // this package. Code in here uses relative paths for its own modules.
      "@/*": ["../json-table-schema-visualizer/src/*"]
    },
    "types": ["vite/client"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
