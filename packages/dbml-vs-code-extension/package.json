{
  "name": "dbml-schema-visualizer",
  "displayName": "DBML Schema Visualizer",
  "description": "Visualize DBML schemas as ERD diagrams, import from PostgreSQL, and compare with a live database.",
  "version": "0.13.0",
  "icon": "assets/logo.png",
  "publisher": "konyshevav",
  "license": "MIT",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension/index.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbmlSchemaVisualizer",
          "title": "%viewsContainer.title%",
          "icon": "assets/icons/panel.svg"
        }
      ]
    },
    "views": {
      "dbmlSchemaVisualizer": [
        {
          "id": "dbml-erd-visualizer.panel",
          "name": "DBML"
        }
      ]
    },
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml",
          "Database Markup Language"
        ],
        "extensions": [
          ".dbml"
        ],
        "icon": {
          "dark": "./icons/dbml-file.svg",
          "light": "./icons/dbml-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dbml",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "dblm-preview-webview",
        "displayName": "%customEditor.diagram%",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.dbml"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "dbml-erd-visualizer.previewDiagrams",
        "title": "%command.previewDiagrams%",
        "icon": "$(open-preview)"
      },
      {
        "command": "dbml-erd-visualizer.previewDiagramsInPlace",
        "title": "%command.previewDiagramsInPlace%"
      },
      {
        "command": "dbml-erd-visualizer.showSource",
        "title": "%command.showSource%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dbml-erd-visualizer.importFromDatabase",
        "title": "%command.importFromDatabase%"
      },
      {
        "command": "dbml-erd-visualizer.compareWithDatabase",
        "title": "%command.compareWithDatabase%"
      },
      {
        "command": "dbml-erd-visualizer.addConnection",
        "title": "%command.addConnection%",
        "icon": "$(add)"
      },
      {
        "command": "dbml-erd-visualizer.refreshConnections",
        "title": "%command.refreshConnections%",
        "icon": "$(refresh)"
      },
      {
        "command": "dbml-erd-visualizer.deleteConnection",
        "title": "%command.deleteConnection%",
        "icon": "$(trash)"
      },
      {
        "command": "dbml-erd-visualizer.importFromConnection",
        "title": "%command.importFromConnection%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dbml-erd-visualizer.compareWithConnection",
        "title": "%command.compareWithConnection%",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dbml-erd-visualizer.importFromConnection",
          "when": "false"
        },
        {
          "command": "dbml-erd-visualizer.compareWithConnection",
          "when": "false"
        },
        {
          "command": "dbml-erd-visualizer.deleteConnection",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "dbml-erd-visualizer.previewDiagrams",
          "when": "resourceLangId == dbml && activeCustomEditorId != 'dblm-preview-webview'",
          "alt": "dbml-erd-visualizer.previewDiagramsInPlace",
          "group": "navigation"
        },
        {
          "command": "dbml-erd-visualizer.showSource",
          "when": "activeCustomEditorId == 'dblm-preview-webview'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "dbml-erd-visualizer.addConnection",
          "when": "view == dbml-erd-visualizer.panel",
          "group": "navigation"
        },
        {
          "command": "dbml-erd-visualizer.refreshConnections",
          "when": "view == dbml-erd-visualizer.panel",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dbml-erd-visualizer.importFromConnection",
          "when": "view == dbml-erd-visualizer.panel && viewItem == dbmlConnection",
          "group": "inline"
        },
        {
          "command": "dbml-erd-visualizer.compareWithConnection",
          "when": "view == dbml-erd-visualizer.panel && viewItem == dbmlConnection",
          "group": "inline"
        },
        {
          "command": "dbml-erd-visualizer.deleteConnection",
          "when": "view == dbml-erd-visualizer.panel && viewItem == dbmlConnection",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dbmlERDPreviewer.preferredTheme": {
          "type": "string",
          "default": "dark",
          "enum": [
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "To use dark mode theme colors",
            "To use light mode theme colors"
          ]
        },
        "dbmlERDPreviewer.scrollDirection": {
          "type": "string",
          "default": "up-out",
          "enum": [
            "up-out",
            "up-in"
          ],
          "enumDescriptions": [
            "To zoom out when scrolling up",
            "To zoom in when scrolling up"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile-tests": "tsc -p tsconfig.tests.json",
    "watch-tests": "tsc -p tsconfig.tests.json -w",
    "pretest": "yarn run lint",
    "lint": "eslint extension --ext ts",
    "test": "jest",
    "test:integration": "yarn build && yarn compile-tests && vscode-test",
    "build": "npx vite build",
    "dev": "npx vite build --watch",
    "package": "yarn run build",
    "preview": "npx vite preview",
    "create:package": "vsce package",
    "publish": "vsce publish",
    "generate:css": "cd ../json-table-schema-visualizer && npx tailwindcss -i ./src/styles/index.css >  ../dbml-vs-code-extension/dist/webview/assets/index.css --minify"
  },
  "devDependencies": {
    "@tomjs/vite-plugin-vscode": "^2.2.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/react": "^18.2.75",
    "@types/react-dom": "^18.2.24",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "vite": "^5.2.8",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "dependencies": {
    "db-to-dbml": "0.0.0",
    "dbml-to-json-table-schema": "0.0.0",
    "extension-shared": "1.0.0",
    "json-table-schema-visualizer": "1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "schema-diff": "0.0.0",
    "shared": "0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AKonyshev/db-schema-visualizer.git"
  },
  "homepage": "https://github.com/AKonyshev/db-schema-visualizer#readme",
  "bugs": {
    "url": "https://github.com/AKonyshev/db-schema-visualizer/issues"
  }
}
