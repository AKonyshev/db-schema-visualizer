{
  "name": "dbml-schema-visualizer",
  "displayName": "DBML Schema Visualizer",
  "description": "Visualize DBML schemas as ERD diagrams, import from PostgreSQL, and compare with a live database.",
  "version": "0.10.0",
  "icon": "assets/logo.png",
  "publisher": "konyshevav",
  "license": "MIT",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension/index.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbmlSchemaVisualizer",
          "title": "DBML Schema Visualizer",
          "icon": "assets/icons/panel.svg"
        }
      ]
    },
    "views": {
      "dbmlSchemaVisualizer": [
        {
          "id": "dbml-erd-visualizer.panel",
          "name": "DBML"
        }
      ]
    },
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML",
          "dbml",
          "Database Markup Language"
        ],
        "extensions": [
          ".dbml"
        ],
        "icon": {
          "dark": "./icons/dbml-logo.svg",
          "light": "./icons/dbml-logo.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "dbml-erd-visualizer.previewDiagrams",
        "title": "Show diagram",
        "icon": {
          "light": "./assets/icons/open-preview.svg",
          "dark": "./assets/icons/open-preview-dark.svg"
        }
      },
      {
        "command": "dbml-erd-visualizer.toggleTableRefs",
        "title": "Toggle table references visibility in DBML"
      },
      {
        "command": "dbml-erd-visualizer.importFromDatabase",
        "title": "DBML: Import from database"
      },
      {
        "command": "dbml-erd-visualizer.compareWithDatabase",
        "title": "DBML: Compare with database"
      },
      {
        "command": "dbml-erd-visualizer.addConnection",
        "title": "DBML: Add database connection",
        "icon": "$(add)"
      },
      {
        "command": "dbml-erd-visualizer.refreshConnections",
        "title": "DBML: Refresh connections",
        "icon": "$(refresh)"
      },
      {
        "command": "dbml-erd-visualizer.deleteConnection",
        "title": "DBML: Delete connection",
        "icon": "$(trash)"
      },
      {
        "command": "dbml-erd-visualizer.importFromConnection",
        "title": "DBML: Import from this connection",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dbml-erd-visualizer.compareWithConnection",
        "title": "DBML: Compare with this connection",
        "icon": "$(diff)"
      }
    ],
    "keybindings": [
      {
        "command": "dbml-erd-visualizer.toggleTableRefs",
        "key": "alt+h",
        "when": "resourceLangId == dbml && activeWebviewPanelName == 'dblm-preview-webview'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == dbml",
          "command": "dbml-erd-visualizer.previewDiagrams",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "dbml-erd-visualizer.addConnection",
          "when": "view == dbml-erd-visualizer.panel",
          "group": "navigation"
        },
        {
          "command": "dbml-erd-visualizer.refreshConnections",
          "when": "view == dbml-erd-visualizer.panel",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dbml-erd-visualizer.importFromConnection",
          "when": "view == dbml-erd-visualizer.panel && viewItem == dbmlConnection",
          "group": "inline"
        },
        {
          "command": "dbml-erd-visualizer.compareWithConnection",
          "when": "view == dbml-erd-visualizer.panel && viewItem == dbmlConnection",
          "group": "inline"
        },
        {
          "command": "dbml-erd-visualizer.deleteConnection",
          "when": "view == dbml-erd-visualizer.panel && viewItem == dbmlConnection",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "DBML Entity Relationship Diagram",
      "properties": {
        "dbmlERDPreviewer.preferredTheme": {
          "type": "string",
          "default": "dark",
          "enum": [
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "To use dark mode theme colors",
            "To use light mode theme colors"
          ]
        },
        "dbmlERDPreviewer.scrollDirection": {
          "type": "string",
          "default": "up-out",
          "enum": [
            "up-out",
            "up-in"
          ],
          "enumDescriptions": [
            "To zoom out when scrolling up",
            "To zoom in when scrolling up"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile-tests": "tsc -p tsconfig.tests.json",
    "watch-tests": "tsc -p tsconfig.tests.json -w",
    "pretest": "yarn run lint",
    "lint": "eslint extension --ext ts",
    "test": "jest",
    "build": "npx vite build && yarn run generate:css",
    "dev": "npx vite build --watch",
    "package": "yarn run build",
    "preview": "npx vite preview",
    "create:package": "vsce package",
    "publish": "vsce publish",
    "generate:css": "cd ../json-table-schema-visualizer && npx tailwindcss -i ./src/styles/index.css >  ../dbml-vs-code-extension/dist/webview/assets/index.css --minify"
  },
  "devDependencies": {
    "@tomjs/vite-plugin-vscode": "^2.2.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/react": "^18.2.75",
    "@types/react-dom": "^18.2.24",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "vite": "^5.2.8",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "dependencies": {
    "db-to-dbml": "0.0.0",
    "dbml-to-json-table-schema": "0.0.0",
    "extension-shared": "1.0.0",
    "json-table-schema-visualizer": "1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "schema-diff": "0.0.0",
    "shared": "0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AKonyshev/db-schema-visualizer.git"
  },
  "homepage": "https://github.com/AKonyshev/db-schema-visualizer#readme",
  "bugs": {
    "url": "https://github.com/AKonyshev/db-schema-visualizer/issues"
  }
}
